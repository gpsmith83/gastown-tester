# === Gastown Tester Environment Configuration ===
# Copy this file to .env.local and fill in your development values
# Never commit real credentials to version control

# === Core Application ===
NODE_ENV=development
PORT=3000

# === GitHub OAuth ===
# Obtain from: https://github.com/settings/applications/new
# Required for user authentication and repository access
# Scope: user:email, read:user, repo (for development repos only)
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# === Session Security ===
# Generate secure random strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_256_bit_minimum
JWT_SECRET=your_jwt_secret_256_bit_minimum
JWT_EXPIRES_IN=1h

# === Linear Integration ===
# Obtain from: https://linear.app/settings/api
# Required for issue tracking and project management
# Scopes: read, write (for development workspace only)
LINEAR_API_KEY=your_linear_api_key
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret
LINEAR_WORKSPACE_ID=your_development_workspace_id

# === AI Provider Configuration ===
# Choose your preferred AI provider and configure accordingly

# Option 1: OpenAI
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=your_openai_api_key
AI_PROVIDER_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-3.5-turbo

# Option 2: Anthropic Claude
# AI_PROVIDER=anthropic
# AI_PROVIDER_API_KEY=your_anthropic_api_key
# AI_PROVIDER_ENDPOINT=https://api.anthropic.com
# AI_PROVIDER_MODEL=claude-3-haiku-20240307

# Option 3: Local/Self-hosted
# AI_PROVIDER=local
# AI_PROVIDER_API_KEY=not_required_for_local
# AI_PROVIDER_ENDPOINT=http://localhost:11434
# AI_PROVIDER_MODEL=llama2

# === Database (Future Implementation) ===
# Will be required when persistent storage is implemented
# DATABASE_URL=postgresql://user:password@localhost:5432/gastown_tester_dev
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_POOL_TIMEOUT=30000

# === Logging & Monitoring ===
LOG_LEVEL=debug
LOG_FORMAT=combined

# === Security Configuration ===
# Rate limiting and security headers
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# === Development Tools ===
# Enable/disable development features
ENABLE_DEBUG_ROUTES=true
ENABLE_API_DOCS=true
ENABLE_REQUEST_LOGGING=true